{
  "permissions": {
    "additionalDirectories": [
      "/home/ara/memoria"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(basename $(git rev-parse --show-toplevel 2>/dev/null || pwd)); f=/home/ara/memoria/04-projects-memory/$p/$p.md; if [ -f \"$f\" ]; then echo \"Project memory: $f ($(wc -c <\"$f\") bytes) — read it before the first substantive action.\"; else echo \"Project memory: none yet for '$p'. Do not create it; /wrap will.\"; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "awaySummaryEnabled": false,
  "theme": "auto"
}
