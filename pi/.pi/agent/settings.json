{
  "lastChangelogVersion": "0.99.2",
  "defaultProvider": "openrouter",
  "defaultModel": "jev-auto",
  "jevRouter": {
    "routerModel": "openrouter/~typesafe/jev-latest",
    "standardModel": "openrouter/z-ai/glm-5.3-flash",
    "complexModel": "openrouter/z-ai/glm-5.3",
    "extremeModel": "openrouter/anthropic/claude-opus-5.5",
    "complexityThreshold": 0.5
  },
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:@ff-labs/pi-fff",
    "npm:@luxusai/pi-hindsight",
    "git:github.com/obra/superpowers",
    "npm:@gotgenes/pi-permission-system"
  ],
  "subagents": {
    "defaultModel": "z-ai/glm-5.3-flash",
    "watchdog": {
      "main": {
        "model": "z-ai/glm-5.3-flash",
        "thinking": "high"
      }
    },
    "agentOverrides": {
      "context-builder": {
        "model": "z-ai/glm-5.3-flash"
      },
      "planner": {
        "model": "z-ai/glm-5.3-flash"
      },
      "researcher": {
        "model": "z-ai/glm-5.3-flash"
      },
      "reviewer": {
        "model": "z-ai/glm-5.3-flash"
      },
      "scout": {
        "model": "z-ai/glm-5.3-flash"
      },
      "worker": {
        "model": "z-ai/glm-5.3-flash"
      }
    }
  },
  "editorPaddingX": 1,
  "quietStartup": true,
  "theme": "dark-noborder"
}