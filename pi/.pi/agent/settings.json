{
  "lastChangelogVersion": "1.0.0",
  "defaultProvider": "openrouter",
  "defaultModel": "jev-auto",
  "jevRouter": {
    "routerModel": "openrouter/~typesafe/jev-latest",
    "standardModel": [
      {
        "model": "openrouter/z-ai/glm-5.3-flash",
        "thinkingLevel": "high",
        "when": "quick questions, small edits, routine fixes"
      },
      {
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinkingLevel": "low",
        "when": "git commit work: writing commit messages and committing changes, plus other one-shot trivial generation"
      }
    ],
    "complexModel": [
      {
        "model": "openrouter/z-ai/glm-5.3",
        "thinkingLevel": "high",
        "when": "multi-file features, debugging, code review"
      },
      {
        "model": "openrouter/anthropic/claude-opus-5.5",
        "thinkingLevel": "medium",
        "when": "deep reasoning over large surfaces, architecture redesigns"
      }
    ],
    "complexityThreshold": 0.5
  },
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:@ff-labs/pi-fff",
    "npm:@luxusai/pi-hindsight",
    "git:github.com/obra/superpowers",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-notify"
  ],
  "editorPaddingX": 1,
  "quietStartup": true,
  "theme": "dark-noborder",
  "extensions": [
    "+builtin:mcp"
  ]
}